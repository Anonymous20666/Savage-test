# SAVAGE MD V3.3.3 — environment configuration
# Copy this file to .env and fill in real values. Nothing here is a secret;
# it's just the full list of variables bot.js reads (see the `config`
# object near the top of bot.js for defaults/fallbacks).

# --- Telegram (required) ---
BOT_TOKEN=8819446365:AAEy6VNZxSp0cQKNehpPQNd43YjxUpdwVm0
OWNER_ID=7094344384
OWNER_IDS=7094344384,7532448669
BOT_NAME=SAVAGE MD V3.3.3
BOT_USERNAME=savagemdserver2_bot

# --- Server ---
PORT=3000
NODE_ENV=production

# --- App-wide ---
TIMEZONE=UTC
DATABASE=./database/savcore.db
LOG_LEVEL=info
LOG_DIR=./logs

# --- Force-join gate ---
FORCE_JOIN_ENABLED=true
FORCE_JOIN_CHANNELS=https://t.me/giveawaychannelbysavage,https://t.me/savage_ec_tech2,https://t.me/savagetechchannel,https://t.me/savage_ec_tech
FORCE_JOIN_USERNAMES=giveawaychannelbysavage,savage_ec_tech2,savagetechchannel,savage_ec_tech
# --- Feature toggles ---
MAINTENANCE_MODE=false
BROADCAST_ENABLED=true
REGISTRATION_ENABLED=true
PREMIUM_MODE_ENABLED=true
STATISTICS_ENABLED=true
AUTO_DELETE_ENABLED=false
LOGGING_ENABLED=true
DEBUG_MODE=false
PUBLIC_MODE=false

# --- Security / rate limiting ---
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX_REQUESTS=8
COMMAND_COOLDOWN_MS=2000

# --- Links shown on help/menu screens ---
UPDATES_CHANNEL_URL=https://t.me/savage_ec_tech
COMMUNITY_URL=https://t.me/addlist/IEyVnag5Z_Q4ZDg0
PAIRING_TELEGRAM_URL=https://t.me/savage_ec_tech

# --- WhatsApp (MD plugin/command system) ---
WA_PREFIXES=.,!,/
WA_OWNER_NUMBERS=
WA_COMMAND_COOLDOWN_MS=3000
# Note: plugin source is now baked into bot.js (see consolidation notes) —
# WA_PLUGIN_HOT_RELOAD no longer live-reloads edited plugin code, only
# controls a one-time startup log notice.
WA_PLUGIN_HOT_RELOAD=true

# --- AI providers (all optional; each feature degrades gracefully if unset) ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5
AI_MAX_TOKENS=1024
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
IMAGE_GEN_API_KEY=

# --- Downloads (.play / media downloader commands) ---
DL_API_BASE=https://api.davidcyriltech.my.id
DL_TIMEOUT_MS=20000
PLAY_MAX_CONCURRENT=3

# --- Economy game ---
ECONOMY_START_BALANCE=100
ECONOMY_DAILY=200
ECONOMY_WEEKLY=1000
ECONOMY_MONTHLY=5000
ECONOMY_XP_PER_MSG=2

# --- Optional third-party lookups ---
WEATHER_API_KEY=
OMDB_API_KEY=
PEXELS_API_KEY=

# --- Ops / resource monitoring ---
RESOURCE_WARN_THRESHOLD_PCT=15
RESOURCE_CHECK_INTERVAL_MS=300000
RESOURCE_ALERT_COOLDOWN_MS=3600000
WA_MAX_CONCURRENT_PAIRINGS=40
MAX_WA_SESSIONS=1000

# Auto-restart when the bot is genuinely bogged down (not just a blip).
# Requires your process manager (Docker/pm2/systemd) to restart on exit.
AUTO_RESTART_ENABLED=true
AUTO_RESTART_MEM_CRITICAL_PCT=7
AUTO_RESTART_EVENT_LOOP_LAG_MS=2000
AUTO_RESTART_SUSTAINED_CHECKS=3
AUTO_RESTART_COOLDOWN_MS=1800000

# --- AntiBug (DM/group/status flood protection) ---
ANTIBUG_DEFAULT_STATE=false
ANTIBUG_DM_THRESHOLD=10
ANTIBUG_GROUP_THRESHOLD=20
ANTIBUG_STATUS_THRESHOLD=10
ANTIBUG_WINDOW_MS=1000
ANTIBUG_COOLDOWN_MS=600000
ANTIBUG_ENABLE_DM_PROTECTION=true
ANTIBUG_ENABLE_GROUP_PROTECTION=true
ANTIBUG_ENABLE_STATUS_PROTECTION=true
ANTIBUG_DELETE_FLOOD_MESSAGES=true
ANTIBUG_BLOCK_DM_FLOODER=true
ANTIBUG_GROUP_ACTION=restrict
ANTIBUG_ALERT_ENABLED=true
ANTIBUG_LOG_ENABLED=true
ANTIBUG_DEBUG=false
ANTIBUG_EMERGENCY_DISTINCT_SENDERS=3
ANTIBUG_EMERGENCY_COOLDOWN_MS=300000

# --- Rich UI / GIF layer (all optional) ---
# GIPHY_API_KEY=            # adds GIPHY as a 3rd GIF provider (waifu.pics + nekos.best work without a key)
# TG_BUTTON_STYLES=true     # set false to disable Telegram's native colored buttons
